# ==============================================================================
# F1 Telemetry — Git Ignore Rules
# ==============================================================================

# ── Secrets & Environment Variables ───────────────────────────────────────────
.env
.env.*
*.env
*.env.local
*.env.*.local
!*.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Node & Proxy Server ───────────────────────────────────────────────────────
node_modules/
proxy-server/node_modules/
proxy-server/cache/*
!proxy-server/cache/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Application Runtime & Database Persistence ────────────────────────────────
f1_state/
influxdb_data/
influxdb_config/
certbot_www/
certbot_certs/

# ── Logs & Debugging ──────────────────────────────────────────────────────────
*.log
logs/
*.pid

# ── IDEs, Editors & Tools ─────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── OS Generated Files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
