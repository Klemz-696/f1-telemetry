# ==============================================================================
# F1 Telemetry & Dashboard — Environment Variables Configuration
# Copy this file to .env and adjust the values (or run `python setup.py`)
# WARNING: NEVER commit the active `.env` file to Git!
# ==============================================================================

# ── InfluxDB v2 Configuration ────────────────────────────────────────────────
# InfluxDB administrative credentials and bucket tokens.
# The setup scripts automatically generate strong random secrets for these.
INFLUX_USER=f1admin
INFLUX_PASSWORD=changeme_strong_password_minimum_16_chars
INFLUX_TOKEN=changeme_cryptographically_secure_admin_token_here

# ── Official F1 Live Timing Stream (Optional) ────────────────────────────────
# Bearer token for direct live SignalR connection to F1 Live Timing.
# If left empty, the system automatically falls back to OpenF1, Jolpica,
# simulation replay engine, and cached session telemetry.
# See docs/F1_LIVE_TOKEN_GUIDE.md for token capture instructions.
F1_AUTH_TOKEN=

# ── Node.js Cache Proxy ───────────────────────────────────────────────────────
PROXY_PORT=3001
NODE_ENV=production

# Comma-separated list of allowed CORS origins for the proxy in production.
# In development, leave blank to allow all origins.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Secret token required to trigger the /flush endpoint (clearing in-memory & disk cache).
# The setup script generates this automatically.
FLUSH_TOKEN=changeme_secret_cache_flush_token_here

# ── FastAPI Backend ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# If left empty, defaults to wildcard ["*"] for development.
API_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Ports Configuration ───────────────────────────────────────────────────────
# External HTTP/HTTPS ports mapped by Nginx on the host machine.
HTTP_PORT=80
HTTPS_PORT=443
